# beacon-app production environment
# Client VITE_* vars are baked into the bundle at build time by Vite.
# Manage-account link target; account.omni.dev is the live account hub.
VITE_ACCOUNT_URL="https://account.omni.dev"
# Aether billing service: Beacon's public plan prices (the Upgrade target)
VITE_BILLING_URL="https://api.billing.omni.dev"
