# beacon-app Environment Configuration

# ================================
# Local Development (default)
# ================================
VITE_BASE_URL=https://localhost:3000
VITE_API_BASE_URL=http://localhost:3001
VITE_AUTH_BASE_URL=https://localhost:8000
# Interim: points at the Gatekeeper account dashboard until account.omni.dev ships
VITE_ACCOUNT_URL="https://identity.omni.dev/dashboard"
VITE_GATEWAY_URL=http://localhost:18790
# Synapse API base URL (required for provider key management and billing)
VITE_SYNAPSE_API_URL=

# Auth (server-side secrets)
# Register app in HIDRA gatekeeper admin to get these values
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SECRET=  # Generate: openssl rand -base64 32

# Server
PORT=3000
NODE_ENV=development

# ================================
# Production (beacon.omni.dev)
# ================================
# VITE_BASE_URL=https://beacon.omni.dev
# VITE_API_BASE_URL=https://api.beacon.omni.dev
# VITE_AUTH_BASE_URL=https://identity.omni.dev
# Interim: points at the Gatekeeper account dashboard until account.omni.dev ships
# VITE_ACCOUNT_URL=https://identity.omni.dev/dashboard
# VITE_GATEWAY_URL=wss://gateway.beacon.omni.dev
